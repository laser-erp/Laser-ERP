# Laser ERP — пример переменных окружения для сервера (Ubuntu).
# Скопируйте на сервер: sudo cp deploy/env.example /etc/laser-erp.env
# и отредактируйте значения. Файл /etc/laser-erp.env не коммитится.

DJANGO_SETTINGS_MODULE=laser_erp.settings_prod
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=замените-на-длинный-случайный-ключ
DJANGO_ALLOWED_HOSTS=erp.example.ru,192.168.1.50
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.example.ru
DJANGO_USE_HTTPS=1

# PostgreSQL (рекомендуется для постоянной работы)
POSTGRES_DB=lasererp
POSTGRES_USER=lasererp
POSTGRES_PASSWORD=замените-пароль
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Если PostgreSQL пока нет — закомментируйте POSTGRES_* и используйте SQLite:
# SQLITE_PATH=/var/www/laser-erp/db.sqlite3

# Сброс пароля без платного SMTP (biz.mail.ru и т.п.):
# PASSWORD_RESET_EMAIL_ENABLED=0 — пользователь вводит логин, получает код, админ выдаёт ссылку
# в разделе «Запросы сброса пароля» или действии у пользователя.
PASSWORD_RESET_EMAIL_ENABLED=0
# PASSWORD_RESET_REQUEST_TTL_HOURS=24

# Опционально: исходящая почта (бесплатный SMTP, например Brevo / личный Яндекс)
# PASSWORD_RESET_EMAIL_ENABLED=1
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# DEFAULT_FROM_EMAIL=noreply@example.ru
# SERVER_DOMAIN=erp.example.ru

# API ФНС (поиск контрагентов по ИНН)
FNS_API_KEY=

# Загрузки
UPLOAD_MAX_SIZE_MB=20

# Опционально: ClamAV, OCR счетов
# CLAMAV_ENABLED=0
# INVOICE_OCR_ENABLED=0
